# Local backend configuration. Copy to .env and keep that file out of Git.
# Values use shell quoting because make api-run sources this file.
DATABASE_URL='host=localhost port=5432 user=fnb_app dbname=fnb_saas sslmode=disable'
PGPASSWORD='REPLACE_WITH_FNB_APP_PASSWORD'
JWT_SECRET='REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES'
WEB_ORIGIN='http://localhost:5173'
HTTP_ADDRESS='127.0.0.1:8080'
APP_ENV='development'

# Use single quotes for passwords containing $, spaces, or other shell symbols.
# A literal single quote inside a value must be encoded as: '\''
# Migration/bootstrap admin credentials are separate from this runtime config.
