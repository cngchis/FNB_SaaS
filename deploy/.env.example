APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-local-owner-password
FNB_APP_PASSWORD=replace-with-a-long-local-runtime-password
POSTGRES_PORT=5432
API_PORT=8080
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
WEB_ORIGIN=http://localhost:5173

# Percent-encode reserved URL characters in passwords used in PostgreSQL URLs.
DATABASE_URL=postgres://fnb_app:replace-with-a-long-local-runtime-password@database:5432/fnb_saas?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://postgres:replace-with-a-long-local-owner-password@database:5432/fnb_saas?sslmode=disable

# Used once by `make bootstrap` to create the first tenant, store, and owner.
BOOTSTRAP_TENANT_NAME=Demo Tenant
BOOTSTRAP_TENANT_SLUG=demo-tenant
BOOTSTRAP_STORE_NAME=Main Store
BOOTSTRAP_STORE_SLUG=main-store
BOOTSTRAP_OWNER_NAME=Tenant Owner
BOOTSTRAP_OWNER_EMAIL=owner@example.test
BOOTSTRAP_OWNER_PASSWORD=change-this-to-a-unique-password
